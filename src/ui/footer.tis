class Footer: Reactor.Component {
    
    function this() {
    }

    function render() {
        return <div #operate>
			<div #item>
				<div #operate_refresh>
					<img #icon src="data:image/png;base64,"></img>
					<span #text>{translate('operate_refresh')}</span>
				</div>
			</div>
			<div #item>
				<div #operate_prev>
					<img #icon src="data:image/png;base64,"></img>
					<span #text>{translate('operate_prev')}</span>
				</div>
			</div>
			<div #item>
				<div #operate_next>
					<img #icon src="data:image/png;base64,"></img>
					<span #text>{translate('operate_next')}</span>
				</div>
			</div>
			<div #item>
				<div #operate_switch>
					<img #icon src="data:image/png;base64,"></img>
					<span #text>{translate('operate_switch')}</span>
				</div>
			</div>
		</div>;
    }
	
	event click $(#operate_refresh) {
		handler.operate_refresh();
    }
	
	event click $(#operate_prev) {
        handler.operate_prev();
    }
	
	event click $(#operate_next) {
        handler.operate_next();
    }
	
	event click $(#operate_switch) {
        handler.operate_switch();
    }
}
$(footer).content(<Footer />);